{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false
  },
  "include": [
    "**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules/**",
      ".git/**",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "repomix-output*",
      "index.html",
      "worker.mjs"
    ]
  }
}