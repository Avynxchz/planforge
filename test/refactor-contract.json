      {
        "name": "plan_status",
        "description": "Ringkasan progress: task selesai/gagal/tersisa dan posisi sekarang.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "next_task",
        "description": "Ambil task berikutnya yang siap dikerjakan (dependensinya sudah selesai). Tidak mengubah apa pun. Menolak menyerahkan task baru kalau budget sesi ini atau plafon biaya sudah habis. Tiap beberapa task (dan di akhir milestone) yang diserahkan adalah GILIRAN-n: audit, perbaikan, refactor, performa — wajib ditutup lewat mark_done sebelum task baru keluar.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "get_task",
        "description": "Kartu tugas lengkap (judul, deskripsi, acceptance criteria, verifikasi, ref).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "mark_done",
        "description": "Tandai task selesai. Worker menjalankan gerbang keras DAN perintah verification task itu SENDIRI, lalu menolak kalau masih merah / verification-nya cuma kalimat / nggak ada file yang berubah — jadi tulis perintah yang beneran kamu jalankan plus output aslinya, bukan kata 'selesai'.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "verification": {
              "type": "string",
              "description": "contoh: `npm test` -> 25 passed in 0.96s"
            }
          },
          "required": [
            "id",
            "verification"
          ]
        }
      },
      {
        "name": "mark_failed",
        "description": "Tandai task gagal beserta alasan supaya runner tidak memutar di situ.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "reason"
          ]
        }
      },
      {
        "name": "mark_blocked",
        "description": "Laporkan task TERKENDALA (bukan gagal): kartu task butuh file/data yang tidak ada, dan membuatnya di luar cakupan task. Tercatat di ledger, tidak dihitung gagal, dan task tidak diserahkan lagi sampai manusia memperbaiki syaratnya. Jangan pakai ini untuk gerbang merah (itu mark_failed).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "reason"
          ]
        }
      },
      {
        "name": "gate_list",
        "description": "Daftar gerbang kualitas aktif (watchlist 1-5) dan ritmenya.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "audit_plan",
